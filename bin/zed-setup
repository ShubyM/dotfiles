#!/usr/bin/env python3
"""Install only the Zed settings and keymap, backing up existing files first."""

import argparse
import datetime
import os
from pathlib import Path
import runpy
import shutil
import tempfile


def main():
    repo = Path(__file__).resolve().parent.parent
    helpers = runpy.run_path(str(repo / "bin/zed-font"))
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--config-dir", type=Path,
        default=helpers["default_settings_path"]().parent,
        help="Zed config directory; defaults to the normal location for this OS.",
    )
    args = parser.parse_args()
    target = args.config_dir.expanduser().resolve()
    names = ("settings.json", "keymap.json")
    for name, expected in zip(names, (dict, list)):
        source = repo / ".config/zed" / name
        if not isinstance(helpers["read_jsonc"](source.read_text()), expected):
            parser.error(f"Invalid Zed configuration: {source}")
        if (target / name).exists() and not (target / name).is_file():
            parser.error(f"Expected a file at {target / name}")

    target.mkdir(parents=True, exist_ok=True)
    existing = [target / name for name in names if (target / name).exists()]
    if existing:
        stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
        backup = target / "backups" / (stamp + "-before-dotfiles-install")
        backup.mkdir(parents=True)
        for path in existing:
            shutil.copy2(path, backup / path.name)
        print(f"Previous config saved in {backup}")

    for name in names:
        fd, temporary = tempfile.mkstemp(prefix=".zed-setup-", dir=target)
        os.close(fd)
        try:
            shutil.copyfile(repo / ".config/zed" / name, temporary)
            os.replace(temporary, target / name)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    print(f"Loaded Zed settings and keymap into {target}")
    print("Zed reloads them automatically. Open or reopen Zed if it is not running.")


if __name__ == "__main__":
    main()
